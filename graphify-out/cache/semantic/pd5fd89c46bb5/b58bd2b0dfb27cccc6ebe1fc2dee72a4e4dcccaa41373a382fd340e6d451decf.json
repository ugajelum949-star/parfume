{"nodes": [{"id": "plan_fix_upload_watermark", "label": "PLAN FIX UPLOAD WATERMARK Document", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_lib_compression_ts", "label": "lib/compression.ts (Client-Side Canvas Compression)", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:32", "rationale": "Client-side compression solves HTTP 413 by reducing file size before server transmission (15MB to ~250KB). Preserves PNG transparency unlike the removed forceJpg approach.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_lib_compression_compressimage", "label": "compressImage()", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_lib_compression_filetobase64", "label": "fileToBase64()", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_app_actions_upload_ts", "label": "app/actions/upload.ts (Clean Upload Pipeline)", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:118", "rationale": "Removing forceJpg preserves original format (PNG transparency, WebP). Removing Sharp watermark avoids server-side image mutation and crash on missing logo.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_lib_s3_storage_ts", "label": "lib/s3-storage.ts (Resilient S3 Storage & Auto-Cleanup)", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:191", "rationale": "ACL fallback handles S3 providers with Bucket Owner Enforced policy. Auto-cleanup removes orphaned files when DB records are deleted.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_lib_s3_storage_uploadtos3", "label": "uploadToS3()", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:216", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_lib_s3_storage_deletefroms3", "label": "deleteFromS3()", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:270", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_lib_s3_storage_getpresigneduploadurl", "label": "getPresignedUploadUrl()", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:293", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_app_actions_products_deleteproduct", "label": "deleteProduct() (S3 Auto-Cleanup)", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:321", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_app_actions_banners_deletebanner", "label": "deleteBanner() (S3 Auto-Cleanup)", "file_type": "document", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:352", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_css_watermark_overlay", "label": "CSS/HTML Watermark Overlay", "file_type": "rationale", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:420", "rationale": "Non-destructive UI watermark replaces server-side Sharp watermark. Text 'BEST PARFUME STORE' rendered via pure CSS with rotation, opacity 6%, pointer-events-none. Avoids image mutation and crash on missing logo.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_admin_compression_integration", "label": "Admin Form Compression Integration Pattern", "file_type": "rationale", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:372", "rationale": "All admin forms with file inputs must follow compressImage -> fileToBase64 -> uploadImage pipeline. Applied to products, settings, banners, wars, testimonials pages.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_fix_upload_watermark_direct_to_telegram_proof", "label": "Payment Proof Direct-to-Telegram Architecture", "file_type": "rationale", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:475", "rationale": "Payment proof images skip S3 storage entirely, sent directly to Telegram Bot admin chat. Keeps S3 bucket clean (Zero S3 Clutter). Order status updated to PAID.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_watermark_replace_sharp", "label": "Replace Sharp Watermark with CSS Overlay", "file_type": "rationale", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:26", "rationale": "Sharp watermark permanently mutates image pixels, causes blur, increases file size, and crashes if logo file is missing. CSS overlay is non-destructive, lightweight, and applied only in the browser.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_s3_orphan_cleanup", "label": "S3 Orphaned File Cleanup", "file_type": "rationale", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:27", "rationale": "Previously, deleting products/banners only removed DB records, leaving physical files in S3. Now deleteProduct and deleteBanner call deleteFromS3 before DB deletion.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_acl_fallback", "label": "S3 ACL Fallback Strategy", "file_type": "rationale", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:28", "rationale": "PutObjectCommand first tries with ACL: 'public-read'. If S3 provider rejects it (Bucket Owner Enforced), retries without ACL header. Handles IDCloudHost compatibility.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_client_side_compression", "label": "Client-Side Image Compression via Canvas", "file_type": "rationale", "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:24", "rationale": "Browser-side HTML5 Canvas compression reduces files from ~15MB to ~250KB before Base64 encoding and server upload. Prevents HTTP 413 Payload Too Large errors.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "plan_fix_upload_watermark_lib_compression_ts", "target": "plan_fix_upload_watermark_lib_compression_compressimage", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:42", "weight": 1.0}, {"source": "plan_fix_upload_watermark_lib_compression_ts", "target": "plan_fix_upload_watermark_lib_compression_filetobase64", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:106", "weight": 1.0}, {"source": "plan_fix_upload_watermark_app_actions_upload_ts", "target": "plan_fix_upload_watermark_lib_s3_storage_uploadtos3", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:128", "weight": 1.0}, {"source": "plan_fix_upload_watermark_app_actions_upload_ts", "target": "plan_fix_upload_watermark_lib_s3_storage_getpresigneduploadurl", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:130", "weight": 1.0}, {"source": "plan_fix_upload_watermark_app_actions_products_deleteproduct", "target": "plan_fix_upload_watermark_lib_s3_storage_deletefroms3", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:331", "weight": 1.0}, {"source": "plan_fix_upload_watermark_app_actions_banners_deletebanner", "target": "plan_fix_upload_watermark_lib_s3_storage_deletefroms3", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$/PLAN_FIX_UPLOAD_WATERMARK.md:358", "weight": 1.0}, {"source": "plan_fix_upload_watermark_css_watermark_overlay", "target": "concept_watermark_replace_sharp", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_FIX_UPLOAD_WATERMARK.md", "source_location": "$graphify-root$